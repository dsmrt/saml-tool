{
  "name": "saml-tool",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "authn": "bun send-authnrequest.ts",
    "authn:get": "bun send-authnrequest.ts -b GET",
    "authn:post": "bun send-authnrequest.ts -b POST",
    "authn:xml": "bun send-authnrequest.ts -o xml",
    "response:init": "bun init-response-config.ts",
    "response": "bun send-response.ts",
    "response:xml": "bun send-response.ts -o xml",
    "metadata": "bun generate-metadata.ts",
    "metadata:idp": "bun generate-metadata.ts idp",
    "metadata:sp": "bun generate-metadata.ts sp",
    "receiver": "bun --hot receiver-server.ts",
    "test": "bun test",
    "test:receiver": "bun test-receiver.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "xml-crypto": "^6.4.0"
  }
}
